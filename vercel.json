{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/proxy.js": { "regions": ["sin1"] }
  },
  "rewrites": [
    { "source": "/inplay-phase", "destination": "/inplay-phase.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
