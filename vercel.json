{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/inplay-beta",  "destination": "/inplay-beta.html" },
    { "source": "/inplay-phase", "destination": "/inplay-phase.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
