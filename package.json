{
  "name": "pump-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Altcoin Pump Monitor — Binance Futures + Gemini AI",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node server.js\" \"vite\"",
    "dev:ws": "node server-vps.js",
    "dev:ws:web": "concurrently -n ws,web -c yellow,green \"node server-vps.js\" \"vite\"",
    "dev:all": "concurrently -n ws,api,web -c yellow,blue,green \"node server-vps.js\" \"node server.js\" \"vite\"",
    "dev:server": "node server.js",
    "dev:front": "vite",
    "trader": "node trader/server.js",
    "test:insights": "node --test src/edge-insights.test.mjs",
    "test:trader": "node --test trader/*.test.js",
    "test:journal": "node --test journal/*.test.js",
    "test:latency": "node --test src/latency-stats.test.mjs",
    "test:ladder": "node --test src/ladder-scale.test.mjs",
    "test:venues": "node --test src/venues-stats.test.mjs",
    "test:hits": "node --test src/hit-stats.test.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server-vps.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "better-auth": "^1.2.8",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.63.0",
    "qrcode-generator": "^1.4.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "resend": "^6.12.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.2"
  }
}
